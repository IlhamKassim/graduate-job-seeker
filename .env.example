# Optional. When set, waitlist and events go to Postgres (Neon on Vercel).
# Without it, they write to .data/capture.json on this machine only.
DATABASE_URL=

# Required to read /api/capture (operator dump of waitlist and events).
CAPTURE_ADMIN_SECRET=

# Optional. When set, API errors are sent to Sentry. Leave blank to skip.
SENTRY_DSN=

# Optional. When set, shortlist and reminder mail is sent through Resend.
# Without it, the operator dump still stores the outbound body.
RESEND_API_KEY=
RETURN_FROM_EMAIL=

# Optional public origin for links in mail if the request has no Host header.
RETURN_PUBLIC_URL=

# Required for the Monday window-reminder cron. Vercel Cron sends Bearer CRON_SECRET.
CRON_SECRET=
